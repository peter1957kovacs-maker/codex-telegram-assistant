# Copy this file to `.env` and fill in the values.

# Telegram bot token from @BotFather (create a bot, it gives you a token).
TELEGRAM_TOKEN=123456789:AA-your-bot-token-here

# Your numeric Telegram user id. Get it by messaging @userinfobot on Telegram.
# ONLY this user can talk to the assistant; everyone else is refused.
ALLOWED_USER_ID=123456789

# Optional: model override for ALL agents (ad hoc). Per-agent models live in
# agents/<name>/.model -- set them from config/agents.json ("model" field) or
# with `bin/ctl.sh model <agent> <model>`. Unset = the Codex default.
# CODEX_MODEL=

# Optional: how many recent messages to feed back as context each turn.
# Higher = more memory per reply but more tokens. Default 12.
CONTEXT_TURNS=12

# Optional: extra OUTBOUND notification channels (webhooks). Proactive messages
# (briefing, heartbeat, stuck-card nudges) also go here. Two-way chat stays on
# Telegram.
# SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXX/YYY

# Optional: Obsidian vault folder for longer notes/docs. Point this at an
# existing Obsidian vault, or leave unset to use store/vault (self-contained,
# openable in Obsidian). Short facts go to SQLite memory; long docs go here.
# OBSIDIAN_VAULT=/Users/you/Obsidian/MyVault

# Optional: voice. If you send a Telegram voice message it is transcribed with
# Whisper (needs `whisper` + ffmpeg installed). Set VOICE_REPLY=1 to also get
# spoken replies to voice messages (macOS `say` / Linux `espeak` + ffmpeg).
# VOICE_REPLY=0
# WHISPER_MODEL=small
# WHISPER_LANG=Hungarian

# Optional: proactive schedule + dashboard port.
# DREAM_TIME=02:07
# BRIEFING_TIME=07:30
# DASHBOARD_PORT=3420
# HEARTBEAT_INTERVAL=1800

# Optional: federation -- link this instance with other Codex-Assistant instances.
# FEDERATION_NAME=my-assistant
# FEDERATION_TOKEN=a-long-shared-secret   (peers must send this token)

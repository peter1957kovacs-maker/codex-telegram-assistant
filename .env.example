# Copy this file to `.env` and fill in the values.

# Telegram bot token from @BotFather (create a bot, it gives you a token).
TELEGRAM_TOKEN=123456789:AA-your-bot-token-here

# Your numeric Telegram user id. Get it by messaging @userinfobot on Telegram.
# ONLY this user can talk to the assistant; everyone else is refused.
ALLOWED_USER_ID=123456789

# Optional: how many recent messages to feed back as context each turn.
# Higher = more memory per reply but more tokens. Default 12.
CONTEXT_TURNS=12

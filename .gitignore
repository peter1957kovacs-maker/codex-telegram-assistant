# Secrets and runtime state -- never commit these.
.env
store/*.db
store/.offset
store/*.log
*.log

# OS / editor noise
.DS_Store
*.pyc
__pycache__/

# Generated at runtime by scaffold.sh / user config
config/agents.json
agents/*/

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Auto-start the whole system at login (macOS). It runs `ctl.sh start`, which
  launches the dashboard, the Telegram bridge, the heartbeat, and the sub-agents
  as background processes. Runs once at load (they keep running); on reboot it
  re-runs. Check health any time with: bin/ctl.sh status

  Install:
    1. Replace __PROJECT_DIR__ below with the absolute project path.
    2. cp to ~/Library/LaunchAgents/com.codexassistant.plist
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.codexassistant.plist
  Stop auto-start:
    launchctl bootout gui/$(id -u)/com.codexassistant
    bin/ctl.sh stop
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.codexassistant</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/bin/ctl.sh</string>
        <string>start</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/store/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/store/launchd.log</string>
</dict>
</plist>
